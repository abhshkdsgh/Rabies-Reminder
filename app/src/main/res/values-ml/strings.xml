    <string name="what_is_rabies">എന്താണ് പേവിഷബാധ?</string>
    <string name="rabies_is_a_deadly_viral_disease_that_attacks_the_brain_and_nerves">"തലച്ചോറിനെയും നാഡികളെയും ബാധിക്കുന്ന മാരകമായ ഒരു വൈറൽ രോഗമാണ് പേവിഷബാധ. "</string>
    <string name="once_symptoms_appear_it_is_almost_always_fatal_but_timely_treatment_can_prevent_it">ലക്ഷണങ്ങൾ കണ്ടുതുടങ്ങിയാൽ ഇത് മാരകമാണ്, എന്നാൽ കൃത്യസമയത്തുള്ള ചികിത്സയിലൂടെ ഇത് തടയാനാകും.</string>
    <string name="cause">കാരണം</string>
    <string name="caused_by_the_rabies_virus_found_in_the_saliva_of_infected_animals">"രോഗം ബാധിച്ച മൃഗങ്ങളുടെ ഉമിനീരിൽ കാണപ്പെടുന്ന റാബിസ് വൈറസ് മൂലമാണ് ഇത് സംഭവിക്കുന്നത്. "</string>
    <string name="in_india_dogs_are_the_most_common_source_but_cats_monkeys_and_wild_animals_can_also_spread_rabies">ഇന്ത്യയിൽ നായ്ക്കളാണ് പ്രധാന ഉറവിടം, എന്നാൽ പൂച്ചകൾ, കുരങ്ങുകൾ, വന്യമൃഗങ്ങൾ എന്നിവയും പേവിഷബാധ പടർത്തും.</string>
    <string name="how_people_get_infected">എങ്ങനെയാണ് ആളുകൾക്ക് രോഗം ബാധിക്കുന്നത്?</string>
    <string name="bite_or_scratch_from_a_rabid_animal">• പേവിഷബാധയുള്ള മൃഗത്തിന്റെ കടിയിലൂടെയോ മാന്തിയിലൂടെയോ\n</string>
    <string name="saliva_or_lick_on_broken_skin_or_eyes_mouth_or_nose">• ഉമിനീരോ നക്കലോ മുറിവേറ്റ ചർമ്മത്തിലോ കണ്ണ്, വായ, മൂക്ക് എന്നിവയിലോ ഏൽക്കുന്നത് വഴി\n</string>
    <string name="handling_infected_animals_without_protection">• സംരക്ഷണമില്ലാതെ രോഗബാധിതരായ മൃഗങ്ങളെ കൈകാര്യം ചെയ്യുന്നത് വഴി</string>
    <string name="signs_of_rabid_animals">പേവിഷബാധയുള്ള മൃഗങ്ങളുടെ ലക്ഷണങ്ങൾ</string>
    <string name="unusual_aggression_or_excessive_drooling">• അസാധാരണമായ ആക്രമണസ്വഭാവം അല്ലെങ്കിൽ അമിതമായ ഉമിനീർ ഒലിപ്പിക്കൽ\n</string>
    <string name="difficulty_walking_biting_objects_or_sudden_behavior_changes">• നടക്കാൻ ബുദ്ധിമുട്ട്, വസ്തുക്കളെ കടിക്കുക, അല്ലെങ്കിൽ പെട്ടെന്നുള്ള സ്വഭാവമാറ്റങ്ങൾ\n</string>
    <string name="even_healthy_looking_animals_can_carry_rabies_always_treat_bites_seriously">• ആരോഗ്യവാനായി കാണപ്പെടുന്ന മൃഗങ്ങളും പേവിഷബാധ വഹിച്ചേക്കാം — കടികളെ എപ്പോഴും ഗൗരവമായി കാണുക</string>
    <string name="categories_of_exposure">സമ്പർക്ക വിഭാഗങ്ങൾ</string>
    <string name="category_i_touching_or_feeding_animals_licks_on_intact_skin_no_treatment_needed">• കാറ്റഗറി I: മൃഗങ്ങളെ തൊടുകയോ ഭക്ഷണം നൽകുകയോ ചെയ്യുക, മുറിവില്ലാത്ത ചർമ്മത്തിൽ നക്കുക → ചികിത്സ ആവശ്യമില്ല\n\n</string>
    <string name="category_ii_minor_scratches_nibbles_without_bleeding_rabies_vaccine_required">• കാറ്റഗറി II: രക്തസ്രാവമില്ലാത്ത ചെറിയ പോറലുകൾ/മാന്തലുകൾ → പേവിഷബാധ വാക്സിൻ ആവശ്യമാണ്\n\n</string>
    <string name="category_iii_deep_bites_scratches_saliva_on_broken_skin_bites_on_face_neck_hands_rabies_vaccine_rabies_immunoglobulin_required">• കാറ്റഗറി III: ആഴത്തിലുള്ള കടികൾ/പോറലുകൾ, മുറിവേറ്റ ചർമ്മത്തിൽ ഉമിനീർ ഏൽക്കുക, മുഖം/കഴുത്ത്/കൈകൾ എന്നിവിടങ്ങളിലെ കടികൾ → പേവിഷബാധ വാക്സിൻ + റാബിസ് ഇമ്യൂണോഗ്ലോബുലിൻ ആവശ്യമാണ്</string>
    <string name="first_aid_act_immediately">പ്രഥമശുശ്രൂഷ – ഉടൻ പ്രവർത്തിക്കുക!</string>
    <string name="_1_wash_the_wound_with_plenty_of_soap_and_running_water_for_at_least_15_minutes">1. സോപ്പും ഒഴുകുന്ന വെള്ളവും ഉപയോഗിച്ച് കുറഞ്ഞത് 15 മിനിറ്റെങ്കിലും മുറിവ് കഴുകുക.\n</string>
    <string name="_2_apply_antiseptic_povidone_iodine_or_alcohol_based">2. ആന്റിസെപ്റ്റിക് (പോവിഡോൺ-അയോഡിൻ അല്ലെങ്കിൽ ആൽക്കഹോൾ അടങ്ങിയത്) പുരട്ടുക.\n</string>
    <string name="_3_do_not_apply_irritants_chili_turmeric_oils_or_cover_tightly">3. മുളക്, മഞ്ഞൾ, എണ്ണകൾ എന്നിവ പുരട്ടരുത് അല്ലെങ്കിൽ മുറിവ് മുറുക്കി കെട്ടരുത്.\n</string>
    <string name="_4_visit_the_nearest_hospital_or_anti_rabies_clinic_immediately">4. ഉടൻ തന്നെ അടുത്തുള്ള ആശുപത്രിയിലോ ആന്റി-റാബിസ് ക്ലിനിക്കിലോ പോകുക.</string>
    <string name="treatment_schedule">ചികിത്സാ ഷെഡ്യൂൾ</string>
    <string name="rabies_vaccination_pep_day_0_3_7_28_day_0_first_injection_intradermal_or_day_0_3_7_14_28_day_0_first_injection_intramuscular">• പേവിഷബാധ വാക്സിനേഷൻ (PEP): 0, 3, 7, 28 ദിവസങ്ങൾ (0-ാം ദിവസം = ആദ്യ കുത്തിവെപ്പ്) (ഇൻട്രാഡെർമൽ) അല്ലെങ്കിൽ 0, 3, 7, 14, 28 ദിവസങ്ങൾ (0-ാം ദിവസം = ആദ്യ കുത്തിവെപ്പ്) (ഇൻട്രാമസ്കുലർ)\n\n</string>
    <string name="rabies_immunoglobulin_rig_for_severe_category_iii_bites_injected_into_and_around_the_wound_as_soon_as_possible">• റാബിസ് ഇമ്യൂണോഗ്ലോബുലിൻ (RIG): കഠിനമായ കാറ്റഗറി III കടികൾക്ക്; എത്രയും വേഗം മുറിവിനകത്തും ചുറ്റും കുത്തിവയ്ക്കുന്നു\n\n</string>
    <string name="tetanus_injection_may_also_be_required">• ടെറ്റനസ് കുത്തിവെപ്പും ആവശ്യമായി വന്നേക്കാം\n\n</string>
    <string name="complete_all_doses_even_if_the_wound_heals_or_the_animal_appears_healthy">മുറിവ് ഉണങ്ങിയാലോ മൃഗം ആരോഗ്യവാനായി കാണപ്പെട്ടാലോ എല്ലാ ഡോസുകളും പൂർത്തിയാക്കുക.</string>
    <string name="prevention">പ്രതിരോധം</string>
    <string name="vaccinate_pets_regularly">• വളർത്തുമൃഗങ്ങൾക്ക് കൃത്യമായി വാക്സിൻ നൽകുക\n</string>
    <string name="avoid_contact_with_unknown_animals">• അപരിചിതരായ മൃഗങ്ങളുമായുള്ള സമ്പർക്കം ഒഴിവാക്കുക\n</string>
    <string name="report_stray_dogs_to_local_authorities">• തെരുവ് നായ്ക്കളെക്കുറിച്ച് പ്രാദേശിക അധികാരികളെ അറിയിക്കുക\n</string>
    <string name="educate_children_about_animal_bite_safety">• മൃഗങ്ങളുടെ കടിയിൽ നിന്നുള്ള സുരക്ഷയെക്കുറിച്ച് കുട്ടികളെ ബോധവൽക്കരിക്കുക</string>
    <string name="remember">ഓർക്കുക!</string>
    <string name="rabies_is_100_preventable_if_treated_early">• നേരത്തെ ചികിത്സിച്ചാൽ പേവിഷബാധ 100% തടയാനാകും\n</string>
    <string name="wash_the_wound_immediately">• മുറിവ് ഉടൻ കഴുകുക\n</string>
    <string name="do_not_wait_for_symptoms_rabies_is_almost_always_fatal_after_onset">"• ലക്ഷണങ്ങൾക്കായി കാത്തിരിക്കരുത് — രോഗം ബാധിച്ചാൽ പേവിഷബാധ മിക്കവാറും മാരകമാണ് "</string>
    <string name="keep_contact_numbers_of_anti_rabies_vaccine_clinics_handy">• ആന്റി-റാബിസ് വാക്സിൻ ക്ലിനിക്കുകളുടെ കോൺടാക്റ്റ് നമ്പറുകൾ കയ്യിൽ കരുതുക</string>
    <string name="please_enable_notifications_to_use_the_reminder">ഓർമപ്പെടുത്തൽ ഉപയോഗിക്കുന്നതിന് ദയവായി അറിയിപ്പുകൾ പ്രവർത്തനക്ഷമമാക്കുക</string>
