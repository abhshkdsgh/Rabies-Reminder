    <string name="wash_the_wound_immediately">• Wash the wound immediately\n</string>
    <string name="do_not_wait_for_symptoms_rabies_is_almost_always_fatal_after_onset">• Do not wait for symptoms — rabies is almost always fatal after onset\n</string>
