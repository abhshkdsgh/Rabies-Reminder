    <string name="what_is_rabies">ರೇಬೀಸ್ ಎಂದರೇನು?</string>
    <string name="rabies_is_a_deadly_viral_disease_that_attacks_the_brain_and_nerves">"ರೇಬೀಸ್ ಮೆದುಳು ಮತ್ತು ನರಗಳ ಮೇಲೆ ದಾಳಿ ಮಾಡುವ ಮಾರಣಾಂತಿಕ ವೈರಲ್ ಕಾಯಿಲೆಯಾಗಿದೆ. "</string>
    <string name="once_symptoms_appear_it_is_almost_always_fatal_but_timely_treatment_can_prevent_it">ಲಕ್ಷಣಗಳು ಕಾಣಿಸಿಕೊಂಡ ನಂತರ, ಇದು ಯಾವಾಗಲೂ ಮಾರಕವಾಗಿರುತ್ತದೆ, ಆದರೆ ಸಕಾಲಿಕ ಚಿಕಿತ್ಸೆಯು ಇದನ್ನು ತಡೆಯಬಹುದು.</string>
    <string name="cause">ಕಾರಣ</string>
    <string name="caused_by_the_rabies_virus_found_in_the_saliva_of_infected_animals">"ಸೋಂಕಿತ ಪ್ರಾಣಿಗಳ ಲಾಲಾರಸದಲ್ಲಿ ಕಂಡುಬರುವ ರೇಬೀಸ್ ವೈರಸ್‌ನಿಂದ ಉಂಟಾಗುತ್ತದೆ. "</string>
    <string name="in_india_dogs_are_the_most_common_source_but_cats_monkeys_and_wild_animals_can_also_spread_rabies">ಭಾರತದಲ್ಲಿ ನಾಯಿಗಳು ಸಾಮಾನ್ಯ ಮೂಲಗಳಾಗಿವೆ, ಆದರೆ ಬೆಕ್ಕುಗಳು, ಮಂಗಗಳು ಮತ್ತು ಕಾಡು ಪ್ರಾಣಿಗಳು ಸಹ ರೇಬೀಸ್ ಹರಡಬಹುದು.</string>
    <string name="how_people_get_infected">ಜನರು ಹೇಗೆ ಸೋಂಕಿಗೆ ಒಳಗಾಗುತ್ತಾರೆ?</string>
    <string name="bite_or_scratch_from_a_rabid_animal">• ಹುಚ್ಚು ಪ್ರಾಣಿಯಿಂದ ಕಡಿತ ಅಥವಾ ಪರಚುವಿಕೆ\n</string>
    <string name="saliva_or_lick_on_broken_skin_or_eyes_mouth_or_nose">• ಒಡೆದ ಚರ್ಮ ಅಥವಾ ಕಣ್ಣುಗಳು, ಬಾಯಿ ಅಥವಾ ಮೂಗಿನ ಮೇಲೆ ಲಾಲಾರಸ ಅಥವಾ ನೆಕ್ಕುವಿಕೆ\n</string>
    <string name="handling_infected_animals_without_protection">• ರಕ್ಷಣೆಯಿಲ್ಲದೆ ಸೋಂಕಿತ ಪ್ರಾಣಿಗಳನ್ನು ನಿರ್ವಹಿಸುವುದು</string>
    <string name="signs_of_rabid_animals">ಹುಚ್ಚು ಪ್ರಾಣಿಗಳ ಚಿಹ್ನೆಗಳು</string>
    <string name="unusual_aggression_or_excessive_drooling">• ಅಸಾಮಾನ್ಯ ಆಕ್ರಮಣಶೀಲತೆ ಅಥವಾ ಅತಿಯಾದ ಜೊಲ್ಲು ಸುರಿಸುವುದು\n</string>
    <string name="difficulty_walking_biting_objects_or_sudden_behavior_changes">• ನಡೆಯಲು ತೊಂದರೆ, ವಸ್ತುಗಳನ್ನು ಕಡಿಯುವುದು ಅಥವಾ ಹಠಾತ್ ವರ್ತನೆಯ ಬದಲಾವಣೆಗಳು\n</string>
    <string name="even_healthy_looking_animals_can_carry_rabies_always_treat_bites_seriously">• ಆರೋಗ್ಯಕರವಾಗಿ ಕಾಣುವ ಪ್ರಾಣಿಗಳು ಸಹ ರೇಬೀಸ್ ಅನ್ನು ಹೊಂದಿರಬಹುದು — ಯಾವಾಗಲೂ ಕಡಿತವನ್ನು ಗಂಭೀರವಾಗಿ ಪರಿಗಣಿಸಿ</string>
    <string name="categories_of_exposure">ಮಾನ್ಯತೆಯ ವರ್ಗಗಳು</string>
    <string name="category_i_touching_or_feeding_animals_licks_on_intact_skin_no_treatment_needed">• ವರ್ಗ I: ಪ್ರಾಣಿಗಳನ್ನು ಮುಟ್ಟುವುದು ಅಥವಾ ಆಹಾರ ನೀಡುವುದು, ಅಖಂಡ ಚರ್ಮದ ಮೇಲೆ ನೆಕ್ಕುವಿಕೆ → ಯಾವುದೇ ಚಿಕಿತ್ಸೆ ಅಗತ್ಯವಿಲ್ಲ\n\n</string>
    <string name="category_ii_minor_scratches_nibbles_without_bleeding_rabies_vaccine_required">• ವರ್ಗ II: ರಕ್ತಸ್ರಾವವಿಲ್ಲದ ಸಣ್ಣ ಪರಚುವಿಕೆ/ಕಚ್ಚುವಿಕೆ → ರೇಬೀಸ್ ಲಸಿಕೆ ಅಗತ್ಯವಿದೆ\n\n</string>
    <string name="category_iii_deep_bites_scratches_saliva_on_broken_skin_bites_on_face_neck_hands_rabies_vaccine_rabies_immunoglobulin_required">• ವರ್ಗ III: ಆಳವಾದ ಕಡಿತಗಳು/ಪರಚುವಿಕೆಗಳು, ಒಡೆದ ಚರ್ಮದ ಮೇಲೆ ಲಾಲಾರಸ, ಮುಖ/ಕುತ್ತಿಗೆ/ಕೈಗಳ ಮೇಲೆ ಕಡಿತಗಳು → ರೇಬೀಸ್ ಲಸಿಕೆ + ರೇಬೀಸ್ ಇಮ್ಯುನೊಗ್ಲಾಬ್ಯುಲಿನ್ ಅಗತ್ಯವಿದೆ</string>
    <string name="first_aid_act_immediately">ಪ್ರಥಮ ಚಿಕಿತ್ಸೆ – ತಕ್ಷಣ ಕಾರ್ಯನಿರ್ವಹಿಸಿ!</string>
    <string name="_1_wash_the_wound_with_plenty_of_soap_and_running_water_for_at_least_15_minutes">1. ಕನಿಷ್ಠ 15 ನಿಮಿಷಗಳ ಕಾಲ ಸೋಪು ಮತ್ತು ಹರಿಯುವ ನೀರಿನಿಂದ ಗಾಯವನ್ನು ಚೆನ್ನಾಗಿ ತೊಳೆಯಿರಿ.\n</string>
    <string name="_2_apply_antiseptic_povidone_iodine_or_alcohol_based">2. ಆಂಟಿಸೆಪ್ಟಿಕ್ (ಪೊವಿಡೋನ್-ಅಯೋಡಿನ್ ಅಥವಾ ಆಲ್ಕೋಹಾಲ್ ಆಧಾರಿತ) ಹಚ್ಚಿರಿ.\n</string>
    <string name="_3_do_not_apply_irritants_chili_turmeric_oils_or_cover_tightly">3. ಕಿರಿಕಿರಿಯುಂಟುಮಾಡುವ ವಸ್ತುಗಳನ್ನು (ಮೆಣಸಿನಕಾಯಿ, ಅರಿಶಿನ, ಎಣ್ಣೆಗಳು) ಹಚ್ಚಬೇಡಿ ಅಥವಾ ಗಟ್ಟಿಯಾಗಿ ಮುಚ್ಚಬೇಡಿ.\n</string>
    <string name="_4_visit_the_nearest_hospital_or_anti_rabies_clinic_immediately">4. ತಕ್ಷಣ ಹತ್ತಿರದ ಆಸ್ಪತ್ರೆ ಅಥವಾ ರೇಬೀಸ್ ವಿರೋಧಿ ಚಿಕಿತ್ಸಾಲಯಕ್ಕೆ ಭೇಟಿ ನೀಡಿ.</string>
    <string name="treatment_schedule">ಚಿಕಿತ್ಸಾ ವೇಳಾಪಟ್ಟಿ</string>
    <string name="rabies_vaccination_pep_day_0_3_7_28_day_0_first_injection_intradermal_or_day_0_3_7_14_28_day_0_first_injection_intramuscular">• ರೇಬೀಸ್ ವ್ಯಾಕ್ಸಿನೇಷನ್ (PEP): ದಿನ 0, 3, 7, 28 (ದಿನ 0 = ಮೊದಲ ಇಂಜೆಕ್ಷನ್) (ಇಂಟ್ರಾಡರ್ಮಲ್) ಅಥವಾ ದಿನ 0, 3, 7, 14, 28 (ದಿನ 0 = ಮೊದಲ ಇಂಜೆಕ್ಷನ್) (ಇಂಟ್ರಾಮಸ್ಕುಲರ್)\n\n</string>
    <string name="rabies_immunoglobulin_rig_for_severe_category_iii_bites_injected_into_and_around_the_wound_as_soon_as_possible">• ರೇಬೀಸ್ ಇಮ್ಯುನೊಗ್ಲಾಬ್ಯುಲಿನ್ (RIG): ತೀವ್ರವಾದ ವರ್ಗ III ಕಡಿತಗಳಿಗೆ; ಸಾಧ್ಯವಾದಷ್ಟು ಬೇಗ ಗಾಯದ ಒಳಗೆ ಮತ್ತು ಸುತ್ತಲೂ ಚುಚ್ಚಲಾಗುತ್ತದೆ\n\n</string>
    <string name="tetanus_injection_may_also_be_required">• ಟೆಟಾನಸ್ ಇಂಜೆಕ್ಷನ್ ಕೂಡ ಬೇಕಾಗಬಹುದು\n\n</string>
    <string name="complete_all_doses_even_if_the_wound_heals_or_the_animal_appears_healthy">ಗಾಯ ವಾಸಿಯಾದರೂ ಅಥವಾ ಪ್ರಾಣಿಯು ಆರೋಗ್ಯಕರವಾಗಿ ಕಂಡರೂ ಎಲ್ಲಾ ಡೋಸ್‌ಗಳನ್ನು ಪೂರ್ಣಗೊಳಿಸಿ.</string>
    <string name="prevention">ತಡೆಗಟ್ಟುವಿಕೆ</string>
    <string name="vaccinate_pets_regularly">• ಸಾಕುಪ್ರಾಣಿಗಳಿಗೆ ನಿಯಮಿತವಾಗಿ ಲಸಿಕೆ ಹಾಕಿ\n</string>
    <string name="avoid_contact_with_unknown_animals">• ಅಪರಿಚಿತ ಪ್ರಾಣಿಗಳೊಂದಿಗೆ ಸಂಪರ್ಕವನ್ನು ತಪ್ಪಿಸಿ\n</string>
    <string name="report_stray_dogs_to_local_authorities">• ಬೀದಿ ನಾಯಿಗಳ ಬಗ್ಗೆ ಸ್ಥಳೀಯ ಅಧಿಕಾರಿಗಳಿಗೆ ವರದಿ ಮಾಡಿ\n</string>
    <string name="educate_children_about_animal_bite_safety">• ಪ್ರಾಣಿ ಕಡಿತದ ಸುರಕ್ಷತೆಯ ಬಗ್ಗೆ ಮಕ್ಕಳಿಗೆ ಶಿಕ್ಷಣ ನೀಡಿ</string>
    <string name="remember">ನೆನಪಿಡಿ!</string>
    <string name="rabies_is_100_preventable_if_treated_early">• ರೇಬೀಸ್ ಅನ್ನು ಮೊದಲೇ ಚಿಕಿತ್ಸೆ ನೀಡಿದರೆ 100% ತಡೆಗಟ್ಟಬಹುದು\n</string>
    <string name="wash_the_wound_immediately">• ತಕ್ಷಣ ಗಾಯವನ್ನು ತೊಳೆಯಿರಿ\n</string>
    <string name="do_not_wait_for_symptoms_rabies_is_almost_always_fatal_after_onset">• ರೋಗಲಕ್ಷಣಗಳಿಗಾಗಿ ಕಾಯಬೇಡಿ — ಪ್ರಾರಂಭದ ನಂತರ ರೇಬೀಸ್ ಯಾವಾಗಲೂ ಮಾರಕವಾಗಿರುತ್ತದೆ\n</string>
    <string name="keep_contact_numbers_of_anti_rabies_vaccine_clinics_handy">• ರೇಬೀಸ್ ವಿರೋಧಿ ಲಸಿಕೆ ಚಿಕಿತ್ಸಾಲಯಗಳ ಸಂಪರ್ಕ ಸಂಖ್ಯೆಗಳನ್ನು ಹತ್ತಿರದಲ್ಲಿಡಿ</string>
